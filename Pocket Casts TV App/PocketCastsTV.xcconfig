#include "../config/PocketCasts.base.xcconfig"

SDKROOT = appletvos
TARGETED_DEVICE_FAMILY = 3 // Apple TV
TVOS_DEPLOYMENT_TARGET = 26.4

// Intentionally the same bundle identifier as the main app
PRODUCT_BUNDLE_IDENTIFIER = $(PRODUCT_BUNDLE_IDENTIFIER_ROOT)

// Code signing - Release
PROVISIONING_PROFILE_SPECIFIER[config=Release] = match AppStore $(PRODUCT_BUNDLE_IDENTIFIER)

// Code signing - Prototype (TODO)
//
// Prototype uses the Enterprise team and a dedicated bundle identifier suffix.
// Using a self-referential override (e.g. `$(PRODUCT_BUNDLE_IDENTIFIER_ROOT).prototype`)
// does not work — Xcode resolves it to `.prototype` only — so hardcode the full value.
PRODUCT_BUNDLE_IDENTIFIER_ROOT[config=Prototype] = au.com.shiftyjelly.podcasts.prototype
DEVELOPMENT_TEAM[config=Prototype] = 99KV9Z6BKV // Automattic, Inc. (Enterprise)
PROVISIONING_PROFILE_SPECIFIER[config=Prototype] = match InHouse $(PRODUCT_BUNDLE_IDENTIFIER)

// Other build settings

OTHER_SWIFT_FLAGS[config=Debug] = -D DEBUG
OTHER_SWIFT_FLAGS[config=StagingDebug] = -D STAGING -D DEBUG
OTHER_SWIFT_FLAGS[config=Prototype] = -D DEBUG
