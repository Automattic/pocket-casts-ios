{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep '\\.swift$' && swiftlint --fix \"$(jq -r '.tool_input.file_path')\" || true"
          }
        ]
      }
    ]
  }
}
